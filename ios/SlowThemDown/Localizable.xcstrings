        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この場所に対応する関係機関はまだ登録されていません。github.com/itsmeduncan/SlowThemDownから登録にご協力いただけます。"
          }
        }
      }
    },
    "No calibration needed — select a vehicle make from the built-in table during capture. Mark the front and rear bumper, and Slow Them Down uses the known vehicle length." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No calibration needed — select a vehicle make from the built-in table during capture. Mark the front and rear bumper, and Slow Them Down uses the known vehicle length."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas calibrar — selecciona una marca de vehículo de la tabla incluida durante la captura. Marca el defensa delantero y trasero, y Slow Them Down usa la longitud conocida del vehículo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真で距離を設定せずに、アプリ内の一覧から車両を選ぶ方法もあります。車両の前後のバンパーに印を付けると、既知の車両の長さを基準に速度を推定します。"
          }
        }
      }
    },
