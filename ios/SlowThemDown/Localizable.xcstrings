    "Slow Them Down" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow Them Down"
          }
        }
      }
    },
    "Slow Them Down estimates vehicle speeds on your street using video from your phone. No radar gun needed — just point, record, and mark." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow Them Down estimates vehicle speeds on your street using video from your phone. No radar gun needed — just point, record, and mark."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow Them Down estima la velocidad de los vehículos en tu calle usando video de tu teléfono. No necesitas pistola de radar — solo apunta, graba y marca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow Them Downは、スマートフォンの動画から近所の道路を走る車両の速度を推定します。レーダー式の速度計は不要です。カメラを向けて録画し、印を付けるだけで使えます。"
          }
        }
      }
    },
    "Slow Them Down is built with the following open source software." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow Them Downは、以下のオープンソースソフトウェアを使用しています。"
          }
        }
      }
    },
